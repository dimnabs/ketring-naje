# App
APP_DOMAIN=localhost
AUTH_URL=http://localhost:3000
AUTH_SECRET=replace_with_a_random_32_byte_secret
AUTH_TRUST_HOST=true

# Google OAuth
AUTH_GOOGLE_ID=replace_with_google_client_id
AUTH_GOOGLE_SECRET=replace_with_google_client_secret

# PostgreSQL (development host connection)
POSTGRES_DB=katering_naje
POSTGRES_USER=naje
POSTGRES_PASSWORD=replace_with_a_strong_password
POSTGRES_PORT=5433
DATABASE_URL=postgresql://naje:replace_with_a_strong_password@localhost:5433/katering_naje

# Payment provider (configure one when checkout is implemented)
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
